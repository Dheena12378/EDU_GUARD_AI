# ============================================================
# EDU CARD AI — Environment Variables Template
# Copy this file to .env and fill in your values
# Never commit real credentials to version control!
# ============================================================

# Database Connection URL (PostgreSQL Cloud or Local)
#
# Examples for popular cloud PostgreSQL providers:
# - Neon:       postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# - Supabase:   postgresql://postgres:YOUR_PASSWORD@db.yourprojectref.supabase.co:5432/postgres
# - Render:     postgresql://user:YOUR_PASSWORD@dpg-sample.oregon-postgres.render.com/edu_card_ai
# - Railway:    postgresql://postgres:YOUR_PASSWORD@containers-us-west-123.railway.app:5432/railway
# - AWS RDS:    postgresql://dbadmin:YOUR_PASSWORD@your-rds-instance.us-east-1.rds.amazonaws.com:5432/educardai
# - Local PG:   postgresql://postgres:postgres@localhost:5432/edu_card_ai
# - SQLite:     sqlite:///./edu_card_ai.db (local dev fallback)
DATABASE_URL=postgresql://your_db_user:your_db_password@your-cloud-host.com:5432/your_database_name

# JWT Authentication
# Generate a secure 64-char key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production-abc123xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Settings
APP_NAME=EDU CARD AI
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-production-domain.com
